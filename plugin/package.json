{
  "name": "steamos-ha",
  "version": "0.2.3",
  "description": "Connects your Steam Machine to Home Assistant",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pimmeke1989/steamos-ha-decky.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steam-machine",
    "home-assistant"
  ],
  "author": "Pimmeke1989",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.22.5",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "@decky/ui": "^4.9.1",
    "react-icons": "^5.3.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
